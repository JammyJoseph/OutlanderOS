// A supplier invoice, from the moment it's requested to the moment it's paid.
//
// Deliberately NOT an invoice store. OutlanderOS asks for the invoice, records
// what was submitted and tracks its status; Xero remains the ledger of record
// and Moss (or Xero) makes the payment. Holding a third copy of every invoice is
// the doubling-up this is meant to avoid — `attachmentUrl` points at the file,
// it isn't the file.
model InvoiceSubmission {
  id               String    @id @default(cuid())
  supplierName     String
  supplierEmail    String
  // ── Request phase ────────────────────────────────────────────────────────
  // Set when Production wraps a shoot and asks the crew to invoice. The token
  // is the crew member's front door: a long random string, since the page it
  // opens is public and must not be guessable from an id.
  token            String?   @unique
  productionId     String?
  production       Production? @relation("productionInvoices", fields: [productionId], references: [id], onDelete: SetNull)
  ioNumber         String? // quoted back to the supplier so finance can match it
  requestedAt      DateTime?
  requestedById    String?
  submittedAt      DateTime?
  // Expected value from the production budget line, so finance can see at a
  // glance whether what arrived matches what was agreed.
  expectedAmount   Float?
  amount           Float?
  currency         String    @default("GBP")
  description      String?
  emailSubject     String?
  emailMessageId   String?   @unique // dedup
  attachmentUrl    String?
  receivedAt       DateTime  @default(now())
  paymentDeadline  DateTime // 30 days from received
  // REQUESTED — asked for, nothing submitted yet (the new first state)
  // RECEIVED → UNDER_REVIEW → APPROVED → PAID, or REJECTED
  status           String    @default("RECEIVED")
  campaignBudgetId String? // project this invoice is coded to
  flagged          Boolean   @default(false)
  flagNote         String?
  reviewedBy       String?
  approvedBy       String?
  approvedAt       DateTime?
  paidAt           DateTime?
  xeroPaymentId    String? // matched Xero payment
  reminderSent     Boolean   @default(false)
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
  @@index([paymentDeadline])
  @@index([campaignBudgetId])
}

// ═══════════════════════════════════════════════════════════════════════════
// ROLLOUT & DISTRIBUTION
//
// The fulfilment plan for one issue: how a print run is split across covers,
// channels, territories, warehouses, stockists and events, and the calendar that
// gets it there.
//
// DESIGN RULE — store inputs, derive everything else. The spreadsheet this
// replaces marks cells "blue = input, black = calculated, green = pulled from
// another tab", and that distinction is load-bearing. Only blue cells are
// columns here. Cover splits per store, per-hub totals, the regional warehouse
// table and every reconciliation variance are COMPUTED in lib/rollout.ts, never
// stored — a stored total is a total that can drift from the rows beneath it.
// ═══════════════════════════════════════════════════════════════════════════

model RolloutPlan {
  id             String       @id @default(cuid())
  magazinePlanId String       @unique
  magazinePlan   MagazinePlan @relation(fields: [magazinePlanId], references: [id], onDelete: Cascade)

  totalPrintRun     Int       @default(0)
  launchDate        DateTime?
  // The hard one. Every milestone counts back from this.
  warehouseDeadline DateTime?

  // ── Economics inputs ──
  gbpToUsd       Float @default(1.27)
  eurToUsd       Float @default(1.08)
  eastCoastShare Float @default(55) // % of US orders priced on the NY lane
  // 0% means the parcel rate is flat however many magazines are in it — the
  // aggressive case, and the whole basis of the bundling argument. Raise it if
  // the carrier charges by weight.
  shippingUpliftPct Float @default(0)
  // Blended placeholder until B2B freight is quoted per lane.
  b2bFreightPerShipment Float @default(45)
  usHubRunningCost      Float @default(0)
  // Last year's UK→US per-order cost. The comparator the whole saving is against.
  lastYearUsRateGbp     Float @default(33)

  // ── The print-to-stockist clock ──
  // Everything about wave timing derives from these five inputs. If the promo
  // wave can't fit inside the lead time, the print date has to move — that's the
  // constraint this exists to surface.
  printCompleteDate    DateTime?
  leadTimeWeeks        Float @default(3)
  promoDaysBeforeDrop1 Int   @default(5)
  widerDaysAfterLastDrop Int @default(2)
  hubToStoreTransitDays Int  @default(4)

  // Free-text assumptions and open items — the bullet list at the foot of the
  // overview. Prose, not data, so it stays prose.
  assumptions String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  covers     RolloutCover[]
  drops      RolloutDrop[]
  waves      StockistWave[]
  rateCards  FulfilmentRateCard[]
  hubs       FulfilmentHub[]
  channels   RolloutChannel[]
  territories RolloutTerritory[]
  stockists  Stockist[]
  events     RolloutEvent[]
  lanes      ShippingLane[]
  milestones RolloutMilestone[]
  profiles   CoverProfile[]
}

// One cover = one SKU = one factory-printed barcode. No substitutions.
model RolloutCover {
  id       String      @id @default(cuid())
  planId   String
  plan     RolloutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  name     String // "Cover 1"
  subject  String? // "Human talent", "Pokemon character — holographic, limited"
  sku      String // OUT02-C1
  sharePct Float // share of the total print run
  // Which drop this cover is released in. Two covers can share a drop.
  dropId   String?
  drop     RolloutDrop? @relation(fields: [dropId], references: [id], onDelete: SetNull)
  // Exactly one cover should be the balancer: it absorbs rounding so every
  // split ties exactly rather than drifting a unit at a time.
  isBalancer Boolean @default(false)
  notes      String?
  sortOrder  Int     @default(0)

  @@index([planId])
}

// A release date, NOT a delivery date. Every B2C unit ships to the warehouses
// once, weeks before the first drop; a drop is a rule in the ecommerce platform
// that makes a cover buyable. Modelling it as a logistics event would invent
// three shipments that don't exist and triple the freight forecast.
model RolloutDrop {
  id        String      @id @default(cuid())
  planId    String
  plan      RolloutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  name      String // "Drop 1"
  goLiveAt  DateTime
  // Share of the B2C pool released here. Territory holds are derived from this,
  // so a drop's units never disagree with the territory split.
  sharePct  Float
  // Absorbs rounding across territories, exactly as the balancer cover does
  // across cover splits.
  isBalancer Boolean @default(false)
  notes     String?
  sortOrder Int     @default(0)

  covers RolloutCover[]

  @@index([planId])
}

// Stockists receive in waves, one delivery per store. The wave carries the
// dates; a store's tier picks its wave. Two waves and 53 shipments, against 149
// if every store received every drop separately.
model StockistWave {
  id        String      @id @default(cuid())
  planId    String
  plan      RolloutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  name      String // "Wave 1 — Promo"
  tier      String // PRIMARY | WIDER — which stores belong to this wave
  // Both dates are DERIVED from the plan's clock inputs and the drop schedule,
  // and cached here only so a wave can be overridden by hand when a carrier
  // gives a real date. Null means "use the derived date".
  inStoreByOverride  DateTime?
  dispatchByOverride DateTime?
  // Promo stock sits in store before the first cover is public, so it needs a
  // signed agreement per account. The wider wave lands after every cover is out
  // and has nothing to embargo.
  isEmbargoed Boolean @default(false)
  notes       String?
  sortOrder   Int     @default(0)

  @@index([planId])
}

// Per-hub pick-and-pack pricing. Order fee is charged once per parcel; item pick
// is charged per magazine. That asymmetry is the entire bundling argument — a
// Full Set costs one order fee, not four.
model FulfilmentRateCard {
  id        String      @id @default(cuid())
  planId    String
  plan      RolloutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  hubId     String?
  hub       FulfilmentHub? @relation(fields: [hubId], references: [id], onDelete: Cascade)
  currency  String  @default("USD") // GBP | USD | EUR
  orderFee  Float   @default(0)
  itemPick  Float   @default(0)
  // Monthly storage/account cost, kept separate because it doesn't scale with
  // orders and shouldn't be folded into a per-parcel figure.
  runningCost Float @default(0)
  // "Yellow cell": a working assumption, not a quote.
  isPlaceholder Boolean @default(false)
  source    String?
  sortOrder Int     @default(0)

  @@index([planId])
}

// Named cover mixes applied to stockists — Even 37.5/37.5/18.75, Talent-led
// 42.5/40/12.5, Character-led 28/28/36, with the balancer cover taking the
// remainder. Percentages are keyed by cover name so adding a cover doesn't
// require a migration: { "Cover 1": 37.5, "Cover 2": 37.5, ... }.
model CoverProfile {
  id        String      @id @default(cuid())
  planId    String
  plan      RolloutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  name      String
  splits    Json        @default("{}")
  isDefault Boolean     @default(false)
  notes     String?
  sortOrder Int         @default(0)

  stockists Stockist[]

  @@index([planId])
}

model FulfilmentHub {
  id        String      @id @default(cuid())
  planId    String
  plan      RolloutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  name      String // "US (SLC)"
  location  String? // "Salt Lake City, Utah"
  serves    String? // what this hub covers
  // Direct-from-printer is a "hub" for allocation purposes but holds no stock.
  isDirect  Boolean @default(false)
  sortOrder Int     @default(0)

  territories RolloutTerritory[]
  stockists   Stockist[]
  events      RolloutEvent[]
  channels    RolloutChannel[]
  rateCards   FulfilmentRateCard[]

  @@index([planId])
}

// How the run divides by purpose: B2C, B2B, seeding, events, reserve, buffer.
model RolloutChannel {
  id      String      @id @default(cuid())
  planId  String
  plan    RolloutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  name    String
  units   Int         @default(0)
  purpose String?
  // Reserve and buffer sit at a named hub; the rest are distributed via
  // territories, events and stockists, so this is null for them.
  hubId   String?
  hub     FulfilmentHub? @relation(fields: [hubId], references: [id], onDelete: SetNull)
  // Which reconciliation family this row belongs to, so the checks know what
  // should tie to what: B2C | B2B | SEEDING | EVENTS | BUFFER.
  kind      String @default("B2C")
  sortOrder Int    @default(0)

  @@index([planId])
}

// B2C and gifting demand by territory, and which hub serves it.
model RolloutTerritory {
  id       String      @id @default(cuid())
  planId   String
  plan     RolloutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  name     String // "Asia-Pacific / Middle East"
  hubId    String?
  hub      FulfilmentHub? @relation(fields: [hubId], references: [id], onDelete: SetNull)
  // One B2C pool per territory. The per-drop hold is DERIVED from each drop's
  // share of the run — the sheet's "held for Drop 1/2/3" columns are calculated,
  // not typed, and storing them would let them drift from the drop schedule.
  b2cUnits   Int @default(0)
  seedingVip Int @default(0)
  sortOrder  Int @default(0)

  @@index([planId])
}

// A confirmed retail account. Cover splits are DERIVED from units × profile.
model Stockist {
  id      String      @id @default(cuid())
  planId  String
  plan    RolloutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  name    String
  city    String?
  market  String? // UK | US | France | … — groups the market reconciliation
  hubId   String?
  hub     FulfilmentHub? @relation(fields: [hubId], references: [id], onDelete: SetNull)
  profileId String?
  profile   CoverProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  units     Int     @default(0)
  // PRIMARY accounts receive before the first drop under a written embargo;
  // WIDER accounts receive after the last one, when every cover is public and
  // there is physically nothing to leak. The tier is the ONLY input — the wave,
  // in-store date, dispatch date and embargo days all follow from it.
  tier      String  @default("WIDER") // PRIMARY | WIDER
  // Named-later source-location slots. They hold no units and must not count as
  // a shipment, so freight isn't billed for a delivery nobody is making.
  isReserved Boolean @default(false)
  // Embargo paperwork, tracked per account because the milestone requires a
  // signed agreement from every promo store before the wave dispatches.
  embargoStatus String? // NOT_REQUIRED | SENT | SIGNED
  embargoSignedAt DateTime?
  // Optional link to the Directory, so a stockist is the same record the
  // commercial team already knows about rather than a second address book.
  contactId String?
  notes     String?
  sortOrder Int     @default(0)

  @@index([planId])
  @@index([contactId])
}

model RolloutEvent {
  id     String      @id @default(cuid())
  planId String
  plan   RolloutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  city   String
  hubId  String?
  hub    FulfilmentHub? @relation(fields: [hubId], references: [id], onDelete: SetNull)
  units     Int     @default(0)
  eventDate DateTime?
  notes     String?
  sortOrder Int     @default(0)

  @@index([planId])
}

// A costed shipping route. Rates arrive at different times from different
// partners, so `ratePerOrder` is nullable and `quoteStatus` carries the reason.
model ShippingLane {
  id     String      @id @default(cuid())
  planId String
  plan   RolloutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  name         String
  ratePerOrder Float?
  currency     String  @default("GBP")
  volume       Int     @default(0)
  quoteStatus  String?
  // "Yellow cell" — a working assumption, not a quote. Counted and surfaced so
  // the headline saving is never presented as firmer than its inputs.
  isPlaceholder Boolean @default(false)
  // The lane being beaten — last year's cost per order. Excluded from cost
  // totals and used as the comparison baseline.
  isBaseline   Boolean @default(false)
  sortOrder    Int     @default(0)

  @@index([planId])
}

model RolloutMilestone {
  id     String      @id @default(cuid())
  planId String
  plan   RolloutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  seq          Int
  window       String? // "By 7 August"
  date         DateTime?
  action       String
  owner        String?
  // Slip one of these and the launch date moves.
  criticalPath Boolean @default(false)
  status       String  @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | DONE | BLOCKED
  notes        String?

  @@index([planId])
}
