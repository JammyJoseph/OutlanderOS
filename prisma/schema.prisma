enum CallSheetStatus {
  DRAFT
  SAVED
  PUBLISHED
}

model CallSheet {
  id              String          @id @default(cuid())
  productionId    String
  production      Production      @relation(fields: [productionId], references: [id], onDelete: Cascade)
  status          CallSheetStatus @default(DRAFT)
  shootTitle      String?
  shootDate       DateTime
  callTime        String          @default("08:00")
  // Master call time for the whole unit — the default every crew/talent member
  // inherits unless their own row carries a `callTime` override. Empty falls
  // back to `callTime` (which is kept mirrored to this for legacy readers).
  unitCallTime    String          @default("")
  wrapTime        String?
  location        Json
  locationLat     Float?
  locationLng     Float?
  schedule        Json
  shotlist        Json            @default("[]")
  // Ordered list of shoot locations — supersedes the single `location` above.
  // [{ name, address, postcode, nearestAE, parkingNotes, contactPerson, whatThreeWords, mapLink, lat, lng }]
  // Order is the movement sequence for the day.
  locations       Json            @default("[]")
  // Overall shot style / creative approach: { tone, visualDevice, notes }
  shotStyle       Json            @default("{}")
  crew            Json
  talent          Json            @default("[]")
  // Rosters normally auto-sort by call time then production hierarchy. Dragging
  // a row sets these, and the stored array order is used verbatim instead —
  // otherwise the next re-sort would silently undo the drag. Per-list, because
  // wanting a hand-built cast order says nothing about the crew list.
  crewManualOrder   Boolean       @default(false)
  talentManualOrder Boolean       @default(false)
  cateringDetails Json            @default("{}")
  documents       Json            @default("[]")
  weatherData     Json?
  productionNotes String?
  safetyNotes     String?
  parkingNotes    String?
  notes           String? // legacy JSON blob — superseded by the dedicated columns above
  shareToken      String?         @unique
  clientShareToken String?        @unique // separate token for the redacted client version
  // ── Industry-standard call sheet sections (Jimmy Choo format) ──
  header            Json          @default("{}") // { productionCompany, jobNumber }
  clientTeam        Json          @default("[]") // [{ role, name }]
  agencyTeam        Json          @default("[]") // [{ role, name, phone, email }]
  productionCompany Json          @default("{}") // { name, address, execProducer, producer }
  callTimes         Json          @default("[]") // [{ time, department }]
  productionMobiles Json          @default("[]") // [{ role, name, phone }]
  movementOrder     Json          @default("{}") // { nearestStation, siteEntrance, techParking, crewParking, routeNotes }
  equipment         Json          @default("{}") // { cameraSupplier, cameraContact, cameraEmail, lightingSupplier, lightingContact, otherNotes }
  distributions   Json            @default("[]") // [{ name, role, email, sentAt, confirmedAt? }]
  distributedAt   DateTime?
  createdAt       DateTime        @default(now())
  presence        CallSheetPresence[]
}

// Who currently has a call sheet open, for the collaborative editor's "Olive is
// editing" pills. One row per (sheet, user); the editor heartbeats every 30s and
// anyone whose lastSeen is older than 60s is treated as gone.
//
// This lives in the DB rather than a module-level Map so it stays correct if
// OutlanderOS is ever run as more than one process — with an in-memory store,
// each node would see a different room and quietly show the wrong people.
// Rows are disposable: a stale one is ignored on read and swept on write.
model CallSheetPresence {
  id          String    @id @default(cuid())
  callSheetId String
  callSheet   CallSheet @relation(fields: [callSheetId], references: [id], onDelete: Cascade)
  // Plain column, not a User relation — presence outlives nothing, and a hard FK
  // here would just add a delete-time constraint for no benefit.
  userId      String
  name        String
  email       String
  lastSeen    DateTime  @default(now())

  @@unique([callSheetId, userId])
  @@index([callSheetId, lastSeen])
}

