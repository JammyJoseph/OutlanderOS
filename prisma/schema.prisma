// ===== COST LEDGER =====
//
// One ledger, many lenses. Every planned and actual cost — whichever portal it
// was entered from — is a row here. Print is this ledger filtered by issue,
// Production filtered by project, Commercial filtered by deal, and Finance is
// the same ledger with no filter at all. That is the P&L.
//
// The point is that nothing needs syncing. Syncing is what you do when you keep
// two copies of a number; the previous PrintBudgetLine kept both a manual
// `actual` and a live `productionActual` and needed a resolvedActual() helper to
// decide which to believe. A ledger never has to decide.
//
// Budget and actual are SEPARATE ROWS, distinguished by `kind`. A plan and a
// fact are different things: budget-vs-actual is a GROUP BY, not a comparison of
// two columns on one row.

enum CostKind {
  BUDGET // planned spend
  COMMITTED // agreed/ordered but not yet invoiced
  ACTUAL // real spend, normally evidenced by an invoice
}

model CostLine {
  id String @id @default(cuid())

  kind        CostKind @default(BUDGET)
  description String
  amount      Float    @default(0) // always ex-VAT — platform rule
  currency    String   @default("GBP")

  // ── Coding: the red thread ────────────────────────────────────────────────
  // Mirrors Xero's chart of accounts and tracking categories so a cost entered
  // in Print lands in the right place in Finance with no reconciliation step.
  // Nullable because Xero is currently disconnected and its codes cannot be
  // fetched (see docs/BACKLOG.md) — codes are backfilled, not migrated.
  // `section` below is effectively a local tracking category and is the natural
  // thing to map onto a real Xero tracking option once connected.
  accountCode      String?
  accountName      String? // denormalised label, captured at coding time
  trackingCategory String?
  trackingOption   String?

  // ── Context: what this cost belongs to ────────────────────────────────────
  // Deliberately not exclusive. A shoot for Issue 02 funded by the Sorel deal is
  // legitimately all three at once, and the P&L should be able to slice by any
  // of them without the cost being duplicated.
  magazinePlanId String?
  magazinePlan   MagazinePlan? @relation(fields: [magazinePlanId], references: [id], onDelete: Cascade)
  productionId   String?
  production     Production?   @relation("productionCostLines", fields: [productionId], references: [id])
  campaignId     String?
  campaign       Campaign?     @relation("campaignCostLines", fields: [campaignId], references: [id])

  // Grouping within whichever lens owns the row. Print issues use
  // MAGAZINE_PRODUCTION | FREELANCE | PRODUCTIONS | EVENTS | MARKETING | OTHER;
  // production budgets use the industry sections PRE_PRODUCTION | CAST_TALENT |
  // CREW | STYLING_GLAM | LOCATIONS | EQUIPMENT | TRANSPORT | CATERING |
  // ART_DEPARTMENT | POST_PRODUCTION. Null when the row belongs to neither.
  section  String?
  category String?
  role     String? // e.g. "DOP", "Lead Talent", "Lighting Kit"

  // A line is often quantity × rate rather than a flat figure. Kept alongside
  // `amount` because losing the derivation makes a budget impossible to argue
  // with — `amount` stays authoritative.
  quantity   Float?
  rate       Float?
  vatPercent Float? // per-line VAT; null means the UI's 20% default. Never in `amount`.

  // Invoice tracking, carried over from production budgets:
  // NOT_INVOICED | INVOICE_RECEIVED | UNDER_REVIEW | APPROVED | PAID
  invoiceStatus  String?
  invoiceUrl     String?
  poNumber       String?
  invoicedAmount Float?

  // ── Drawdown: an ACTUAL may point at the BUDGET row it consumes ───────────
  // Optional by design: unbudgeted spend must always be recordable, otherwise
  // people work around the system and the ledger stops being the truth.
  budgetLineId String?
  budgetLine   CostLine?  @relation("budgetDrawdown", fields: [budgetLineId], references: [id])
  drawdowns    CostLine[] @relation("budgetDrawdown")

  // ── Reconciliation ────────────────────────────────────────────────────────
  invoiceRef String? // Xero invoice number / InvoiceSubmission id once ingested
  paidAt     DateTime?

  notes     String?
  sortOrder Int     @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String?
  createdByName String?

  @@index([magazinePlanId, kind])
  @@index([productionId, kind])
  @@index([campaignId, kind])
  @@index([accountCode])
  @@index([budgetLineId])
  @@index([kind])
}

